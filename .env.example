# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg://excon:excon@localhost:5432/excon

# Local LLM (OpenAI-compatible MLX server)
MLX_BASE_URL=http://127.0.0.1:8080
MLX_MODEL=mlx-community/Qwen3-8B-4bit

# Research providers
TAVILY_API_KEY=
PROSPEO_API_KEY=

# API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RELOAD=true

# Seller extraction (defaults shown)
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_EXTRACT_CALLS=10
# CRAWL_MAX_PAGES=10
# UPLOAD_DIR=uploads
# UPLOAD_MAX_BYTES=10000000
# UPLOAD_MAX_FILES=10
